# Vercel 환경변수 예시 (.env.example — 실제 값은 Vercel Settings → Environment Variables 에 입력)
# 이 파일은 참고용이며 저장소에는 키를 실제로 적어 두지 않습니다.

# ── 필수 ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 권장: 앱 ⚙ 설정 → 접근 코드 에 같은 값을 입력해야 생성·저장이 됩니다 ──
APP_ACCESS_CODE=

# ── 구글 드라이브 저장 (Apps Script 웹앱) ─────────────
# 미설정 시 '드라이브에 저장'은 데모 안내만 보여 줍니다.
GOOGLE_DRIVE_WEBHOOK_URL=
# Apps Script 스크립트 속성 SHARED_TOKEN 과 같은 값 (권장)
WEBHOOK_SHARED_SECRET=

# ── 선택: 추가로 허용할 오리진 (쉼표 구분, 같은 오리진·localhost 는 자동 허용) ──
APP_ALLOWED_ORIGINS=

# ── 선택: 모델 · 응답 토큰 · 입력 길이 ─────────────────
APP_MODEL=claude-sonnet-5-5
APP_MAX_TOKENS=3000
MAX_PROMPT_CHARS=12000

# ── 선택: 생성 요청 속도 제한 (IP당 분당·일일, 전체 일일) ──
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_PER_DAY=200
RATE_LIMIT_GLOBAL_PER_DAY=500

# ── 선택: 드라이브 저장 요청 속도 제한 ────────────────
SAVE_RATE_LIMIT_PER_MIN=10
SAVE_RATE_LIMIT_PER_DAY=100
